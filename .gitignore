# ─────────────────────── build artifacts ───────────────────────
/target
**/target/
*.pdb

# ─────────────────────── reckon sidecar ───────────────────────
/.reckon
**/.reckon/
*.db
*.db-journal
*.db-wal
*.db-shm

# ─────────────────────── embedded model cache ───────────────────────
# fastembed downloads ~90MB of ONNX weights on first search.
/models/
/.fastembed_cache/
**/.fastembed_cache/

# ─────────────────────── generated demo repo ───────────────────────
# Built by `reckon-seed`; do not nest it inside this repo.
/demo-repo/

# ─────────────────────── source handoffs (not deliverable) ───────────────────────
/coder3/
/coder3-handoff.zip

# ─────────────────────── editors / agent caches ───────────────────────
/.claude/**
/.vscode/**
/.kiro/**
/.antigravity/**
/.idea/

# ─────────────────────── OS junk ───────────────────────
.DS_Store
Thumbs.db
